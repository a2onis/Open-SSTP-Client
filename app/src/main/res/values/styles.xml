<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ============================= Typography ============================= -->

    <style name="TextAppearance.OpenSSTP.Category" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textColor">@color/md_primary</item>
    </style>

    <style name="TextAppearance.OpenSSTP.Summary" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/md_on_surface_variant</item>
        <item name="android:lineSpacingExtra">2sp</item>
    </style>

    <style name="TextAppearance.OpenSSTP.ToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/md_on_surface</item>
    </style>

    <style name="TextAppearance.OpenSSTP.ToolbarSubtitle" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/md_primary</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <style name="TextAppearance.OpenSSTP.HeroStatus" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">@color/hero_text</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <style name="TextAppearance.OpenSSTP.HeroEndpoint" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">@color/hero_text</item>
    </style>

    <style name="TextAppearance.OpenSSTP.HeroDetail" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/hero_text_muted</item>
    </style>

    <style name="TextAppearance.OpenSSTP.HeroBadge" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textColor">@color/hero_text</item>
        <item name="android:letterSpacing">0.12</item>
    </style>

    <!-- ============================ Buttons ================================ -->

    <style name="Widget.OpenSSTP.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:textColor">@color/hero_button_text</item>
        <item name="backgroundTint">@color/hero_text</item>
        <item name="iconTint">@color/hero_button_text</item>
        <item name="cornerRadius">20dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">8dp</item>
    </style>

    <style name="Widget.OpenSSTP.Button.Ghost" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/hero_text</item>
        <item name="strokeColor">@color/hero_outline</item>
        <item name="iconTint">@color/hero_text</item>
        <item name="cornerRadius">20dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">8dp</item>
    </style>

    <style name="Widget.OpenSSTP.TabLayout" parent="Widget.MaterialComponents.TabLayout">
        <item name="tabIndicatorColor">@color/md_primary</item>
        <item name="tabSelectedTextColor">@color/md_primary</item>
        <item name="tabTextColor">@color/md_on_surface_variant</item>
        <item name="tabIndicatorFullWidth">false</item>
        <item name="tabInlineLabel">true</item>
        <item name="tabRippleColor">@color/md_primary_container</item>
    </style>

    <!-- ============================ Preferences ============================= -->

    <style name="PreferenceThemeOverlay.OpenSSTP" parent="@style/BasePreferenceThemeOverlay">
        <item name="preferenceCategoryStyle">@style/Preference.OpenSSTP.Category</item>
        <item name="preferenceCategoryTitleTextAppearance">@style/TextAppearance.OpenSSTP.Category</item>
        <item name="preferenceCategoryTitleTextColor">@color/md_primary</item>
    </style>

    <style name="Preference.OpenSSTP.Category" parent="@style/Preference.Category.Material">
        <item name="android:layout">@layout/preference_category_open_sstp</item>
        <item name="allowDividerAbove">false</item>
        <item name="allowDividerBelow">false</item>
    </style>

    <!-- Overrides of the androidx.preference defaults so summaries match the theme. -->
    <style name="PreferenceSummaryTextStyle">
        <item name="android:textAppearance">@style/TextAppearance.OpenSSTP.Summary</item>
    </style>

    <style name="PreferenceCategoryTitleTextStyle">
        <item name="android:textAppearance">@style/TextAppearance.OpenSSTP.Category</item>
        <item name="android:textColor">@color/md_primary</item>
    </style>
</resources>
