<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory android:title="Configuration">
        <kittoku.osc.preference.custom.HomeHostnamePreference
            android:key="HOME_HOSTNAME"
            android:icon="@drawable/ic_cloud_24" />

        <kittoku.osc.preference.custom.HomeUsernamePreference
            android:key="HOME_USERNAME"
            android:icon="@drawable/ic_person_24" />

        <kittoku.osc.preference.custom.HomePasswordPreference
            android:key="HOME_PASSWORD"
            android:icon="@drawable/ic_lock_24" />

        <Preference
            android:key="manage_configurations"
            android:title="Configurations"
            android:icon="@drawable/ic_list_24" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Smart connect">
        <Preference
            android:key="smart_overview"
            android:title="@string/smart_overview"
            android:icon="@drawable/ic_speed_24" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Session">
        <kittoku.osc.preference.custom.HomeStatusPreference android:key="HOME_STATUS" />
    </PreferenceCategory>

</PreferenceScreen>
