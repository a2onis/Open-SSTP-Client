<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>OpenSstpWin</RootNamespace>
    <AssemblyName>OpenSstpWin</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Allows building (compile only) on non-Windows hosts such as CI containers. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Version>1.11.0</Version>
    <FileVersion>1.11.0.0</FileVersion>
    <AssemblyVersion>1.11.0.0</AssemblyVersion>
    <Company>Open SSTP Client contributors</Company>
    <Product>Open SSTP Client for Windows</Product>
    <Copyright>MIT licensed. Based on Open-SSTP-Client by kittoku.</Copyright>
    <PublishReadyToRun>false</PublishReadyToRun>
    <!-- Self-contained/single-file is selected on the publish command line so that
         the test project can reference this project without inheriting it. -->
    <DebugType>none</DebugType>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OpenSstpWin.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- ImplicitUsings does not include System.Runtime/System.IO for every target,
         and span extensions (ReadOnlySpan.ToArray, Stream.ReadAsync) live there. -->
    <Using Include="System.Runtime" />
    <Using Include="System.IO" />
  </ItemGroup>

</Project>
